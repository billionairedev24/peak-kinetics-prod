# Cross-origin backend (set in Cloudflare Pages env vars for prod & preview).
# Leave unset locally if running backend on the same host.
NEXT_PUBLIC_API_URL=https://api.peakkineticspt.com

# Cloudflare Turnstile (public site key). Real value provisioned in Pages env.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token (provisioned in Pages env for prod).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
